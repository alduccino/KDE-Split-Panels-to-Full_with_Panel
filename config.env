# ============================================================
#  config.env — Island Panels shared configuration
#  Sourced by install.sh; values are also embedded into
#  the KWin script at install time via sed substitution.
#
#  Edit here, then re-run: ./install.sh install
# ============================================================

PANEL_HEIGHT=44
PANEL_LOCATION="bottom"        # "bottom" or "top"
MARGIN_EDGE=8                  # px gap from left/right screen edges
LAUNCHER_WIDGET="org.kde.plasma.kickoff"   # or kicker
TASKS_WIDGET="org.kde.plasma.icontasks"   # or taskmanager
ADD_CLOCK=true                 # include digitalclock in right island
